# Copy to .env to override any default. There are no secrets in this project:
# the MLflow server runs without authentication and is only exposed locally.

# Memory each Spark worker offers to executors. Two workers at 3g fit in a
# Docker Desktop VM of ~8 GB alongside the master, history server and MLflow.
SPARK_WORKER_MEMORY=3g
SPARK_WORKER_CORES=2
EXECUTOR_MEMORY=2g

# Time-based split boundaries (PaySim step = one hour). Leave empty to use the
# defaults in jobs/train.py, which are chosen from the EDA.
TRAIN_END_STEP=
VALID_END_STEP=
