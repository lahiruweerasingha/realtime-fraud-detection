# Template for .env. `make env` (run automatically by every make target) copies
# this file to .env and replaces each `change-me` with a random secret, so no
# usable credential ever exists in the repository. .env is gitignored.

# --- Spark ------------------------------------------------------------------
# Memory each Spark worker offers to executors. Two workers at 3g fit in a
# Docker Desktop VM of ~8 GB alongside the master, history server and MLflow.
SPARK_WORKER_MEMORY=3g
SPARK_WORKER_CORES=2
EXECUTOR_MEMORY=2g

# Time-based split boundaries (PaySim step = one hour). Leave empty to use the
# defaults in jobs/train.py, which are chosen from the EDA.
TRAIN_END_STEP=
VALID_END_STEP=

# Where results are written, inside the containers. The default is the
# committed evidence/. For a side run (e.g. on synthetic data) use
# /app/output/evidence, which is gitignored.
EVIDENCE_DIR=/app/evidence

# --- Streaming ----------------------------------------------------------------
# Hours scored by the streaming replay: the normal-volume test hours. Read by
# both the Spark export (make stream-data) and the Flink job. The synthetic
# data covers hours 1-200: use 175 and 200 there.
SCORE_FROM_STEP=378
SCORE_TO_STEP=408

INFLUX_ORG=fraud
# The Grafana dashboard queries this bucket by name; change both together.
INFLUX_BUCKET=fraud-monitoring
INFLUX_PASSWORD=change-me
INFLUX_TOKEN=change-me
GRAFANA_ADMIN_PASSWORD=change-me
